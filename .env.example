# ═══════════════════════════════════════════════════════════════════════
# DISPATCH Platform — Environment Variables
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit the values for your environment.
# Every variable below is OPTIONAL — the system runs with all defaults.
#
# Load in your shell:  export $(grep -v '^#' .env | xargs)
# Or on Windows:       for /f "tokens=*" %i in (.env) do set %i
# ═══════════════════════════════════════════════════════════════════════

# ── Portal (Web UI) ──────────────────────────────────────────────────
# PORTAL_SECRET_KEY=           # Flask session signing key (warns if unset)
# PORTAL_DATA_DIR=             # Root for JSON data + SQLite DB (default: portal/data)
# PORTAL_UPLOAD_DIR=           # Evidence file uploads (default: <PORTAL_DATA_DIR>/uploads)
# PORTAL_HOST=127.0.0.1        # Bind address
# PORTAL_PORT=8080              # Bind port
# PORTAL_INQUIRY_THRESHOLD=90   # Score threshold for broker inquiry
# PORTAL_INQUIRY_MODE=HUMAN_REVIEW

# ── Company Info (Rate Confirmations) ────────────────────────────────
# DISPATCH_COMPANY_NAME=
# DISPATCH_COMPANY_ADDRESS=
# DISPATCH_COMPANY_PHONE=
# DISPATCH_COMPANY_EMAIL=
# DISPATCH_MC_NUMBER=
# DISPATCH_DOT_NUMBER=

# ── Archive (CIN-Lite File Storage) ──────────────────────────────────
# DISPATCH_ARCHIVE_PATH=       # Root for archive folder tree (default: cin_lite/Archive)
#                               # Example: D:\Archive  or  /mnt/external/archive

# ── Email / SMTP ─────────────────────────────────────────────────────
# Without DISPATCH_SMTP_HOST, emails are saved as .eml files in Archive/Outbox.
# DISPATCH_SMTP_HOST=           # e.g. smtp.gmail.com, smtp.sendgrid.net
# DISPATCH_SMTP_PORT=587
# DISPATCH_SMTP_USER=
# DISPATCH_SMTP_PASSWORD=
# DISPATCH_SMTP_STARTTLS=1      # 1=yes, 0=no
# DISPATCH_EMAIL_FROM=           # default: dispatch@<domain>
# DISPATCH_EMAIL_REVIEWER=       # default: reviewer@<domain>
# DISPATCH_EMAIL_DOMAIN=dispatch.local
# DISPATCH_EMAIL_SECRET=         # HMAC secret for email action links (warns if unset)
# DISPATCH_PORTAL_URL=http://127.0.0.1:8080   # Base URL for email action buttons

# ── SAM.gov API (Contract Acquisition) ───────────────────────────────
# Without DISPATCH_SAM_API_KEY, the pipeline uses local sample data.
# DISPATCH_SAM_API_KEY=          # api.data.gov API key
# DISPATCH_SAM_LIMIT=10          # Results per query page
# DISPATCH_SAM_NAICS=            # NAICS code filter
# DISPATCH_SAM_PTYPE=            # Procurement type filter (e.g. o,k,p)
# DISPATCH_SAM_FETCH_DESCRIPTION=1
# DISPATCH_SAM_POSTED_FROM=      # MM/DD/YYYY (default: 7 days ago)
# DISPATCH_SAM_POSTED_TO=        # MM/DD/YYYY (default: today)

# ── Claude AI (Agents) ───────────────────────────────────────────────
# Without ANTHROPIC_API_KEY, all 4 agents use deterministic fallback logic.
# ANTHROPIC_API_KEY=
# DISPATCH_MODEL=claude-opus-4-8

# ── Load Board (Dispatch Acquisition) ────────────────────────────────
# DISPATCH_LOAD_SOURCE=          # Local JSON directory (default: portal/sample_dispatch_data)
# DISPATCH_LOAD_API_URL=         # Load board API endpoint
# DISPATCH_LOAD_API_KEY=         # Bearer token for load board API

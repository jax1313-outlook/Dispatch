# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Packaging build artifacts (created by `pip install -e .` / `python -m build`,
# which became usable again when pyproject.toml gained its package discovery)
build/
dist/
*.egg-info/

# Test & coverage artifacts
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment secrets and anything that can leak one
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
local_settings.py

# Runtime output. A committed Flask/Werkzeug log can contain a debugger PIN --
# that is not hypothetical, it happened in the Jules repository and had to be
# removed by hand (W0-1).
*.log
logs/
flask_app.log

# Pipeline runtime outputs (generated by running cin_lite)
cin_lite/Archive/

# Portal runtime data (SQLite, JSON files)
portal/data/

# Claude agent workspace
.claude/

# Local-machine proof artifacts (Operational Readiness Mission Section 10.2).
# These are produced by running Dispatch on the target machine and contain real
# paths, real record identifiers, real evidence hashes, and a rehearsal
# database. None of that belongs in version control. The committed, inspectable
# versions of these documents live in docs/readiness/.
proof/

# Launcher runtime state: PID files, launch logs, and the last-failure record.
# Section 3.4 requires the logs directory to sit outside version control, and a
# launch log can carry an environment dump.
.dispatch/
dispatch_launcher_logs/
run/

# The operator's live Policy Profile is theirs and machine-specific.
# The shipped defaults (config/policy_profile.default.json) ARE committed.
config/policy_profile.json
